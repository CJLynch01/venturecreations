<%- include('../partials/v2/head', { title: 'Blog' }) %>
<section class="blk gut"><div class="in">
  <div class="head"><div><div class="eyebrow">From the studio</div><h1>The blog</h1></div></div>
  <% if (!posts.length) { %>
    <p class="empty">No posts yet. Check back soon.</p>
  <% } else { %>
    <div class="posts">
      <% posts.forEach(post => { %>
        <a class="post" href="/blog/<%= post.slug %>">
          <% if (post.coverImageUrl) { %><img src="<%= post.coverImageUrl %>" alt="" loading="lazy"><% } %>
          <div><% if (post.topic) { %><span class="eyebrow"><%= post.topic %></span><% } %>
            <h2><%= post.title %></h2>
            <% if (post.shortDescription) { %><p class="muted" style="margin:0"><%= post.shortDescription %></p><% } %>
            <span class="muted" style="font-size:13px"><%= post.createdAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span></div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div></section>
<%- include('../partials/v2/foot') %>
