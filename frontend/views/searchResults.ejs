<%- include('partials/v2/head') %>
<section class="blk gut"><div class="in">
  <div class="head"><div><div class="eyebrow">Search</div><h1><%= query ? `“${query}”` : 'Search the shop' %></h1></div></div>
  <form action="/search" method="GET" class="field" style="max-width:480px;margin-bottom:26px"><input type="text" name="q" value="<%= query %>" placeholder="Try cats, mission, Halloween" aria-label="Search shirts"></form>
  <% if (results.length) { %>
    <div class="grid"><% results.forEach(p => { %><%- include('partials/v2/card', { p }) %><% }) %></div>
  <% } else if (query) { %>
    <p class="empty">No shirts match “<%= query %>”. <a href="/shop">Browse all shirts</a></p>
  <% } %>
</div></section>
<%- include('partials/v2/foot') %>
