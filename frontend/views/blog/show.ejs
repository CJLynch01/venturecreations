<%- include('../partials/v2/head', { title: post.title }) %>
<article class="page gut"><div class="narrow article">
  <a href="/blog" style="font-size:14px">← All posts</a>
  <% if (post.topic) { %><div class="eyebrow" style="margin-top:22px"><%= post.topic %></div><% } %>
  <h1><%= post.title %></h1>
  <p class="muted" style="font-size:14px;margin:0 0 20px"><%= post.author || 'Elisha' %> · <%= post.createdAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></p>
  <% if (post.coverImageUrl) { %><img src="<%= post.coverImageUrl %>" alt="" style="margin-bottom:24px"><% } %>
  <% if (post.shortDescription) { %><p style="font-size:20px;color:var(--muted)"><%= post.shortDescription %></p><% } %>
  <div><%- post.content.replace(/\r?\n/g, "<br>") %></div>
  <% if (post.hashtags && post.hashtags.length) { %><div class="tags" style="margin-top:24px"><% post.hashtags.forEach(t => { %><span>#<%= t %></span><% }) %></div><% } %>
  <p style="margin-top:36px"><a class="btn ghost" href="/shop">Shop the shirts</a></p>
</div></article>
<%- include('../partials/v2/foot') %>
