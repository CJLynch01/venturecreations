<%- include('partials/v2/head') %>

<section class="blk gut"><div class="in">
  <div class="head"><div><div class="eyebrow">The collection</div><h1><%= active === 'all' ? 'All shirts' : shop.COLLECTIONS.find(c => c.id === active).name %></h1></div></div>
  <nav class="chips" aria-label="Collections">
    <a href="/shop" aria-current="<%= active === 'all' %>">All<small class="tabnum"><%= total %></small></a>
    <% shop.COLLECTIONS.forEach(c => { if (!counts[c.id]) return; %>
      <a href="/shop?c=<%= c.id %>" aria-current="<%= active === c.id %>"><%= c.name %><small class="tabnum"><%= counts[c.id] %></small></a>
    <% }) %>
  </nav>
  <% if (products.length) { %>
    <div class="grid"><% products.forEach(p => { %><%- include('partials/v2/card', { p }) %><% }) %></div>
  <% } else { %>
    <p class="empty">No shirts in this collection yet.</p>
  <% } %>
</div></section>

<%- include('partials/v2/trust') %>
<%- include('partials/v2/foot') %>
