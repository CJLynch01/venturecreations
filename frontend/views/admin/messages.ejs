<%- include('../partials/v2/head') %>
<%
  // Reply opens her email app with the subject and their message already filled in
  const replyLink = m => {
    const quoted = (m.message || '').split(/\r?\n/).map(l => '> ' + l).join('\n');
    const body = `Hi ${(m.name || '').split(' ')[0] || 'there'},\n\n\n\n---\nOn ${m.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })} you wrote:\n${quoted}`;
    return `mailto:${encodeURIComponent(m.email)}?subject=${encodeURIComponent('Re: ' + (m.subject || 'Your message to Venture Creations'))}&body=${encodeURIComponent(body)}`;
  };
%>
<section class="page gut"><div class="narrow" style="display:grid;gap:18px">
  <div><a href="/admin" style="font-size:14px">← Admin</a><h1 style="font-size:clamp(30px,4vw,44px)">Messages</h1>
    <p class="muted">What people sent through the contact form. Reply opens your email with their message filled in.</p></div>
  <% if (deleted) { %><p class="pf-ok" role="status">Message deleted.</p><% } %>
  <% if (!messages.length) { %><p class="card muted">No messages yet.</p><% } %>
  <% messages.forEach(m => { %>
    <div class="card msg-card<%= m.read ? '' : ' msg-new' %>">
      <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap"><b><%= m.subject || '(no subject)' %><%= m.read ? '' : ' · new' %></b>
        <span class="muted" style="font-size:13px"><%= m.createdAt.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span></div>
      <span class="muted" style="font-size:14px"><%= m.name %> · <%= m.email %></span>
      <p style="margin:6px 0 0;white-space:pre-wrap"><%= m.message %></p>
      <div class="pl-acts msg-acts">
        <a class="btn" href="<%= replyLink(m) %>">Reply</a>
        <form action="/admin/messages/<%= m._id %>/delete" method="POST" class="pl-del">
          <button class="btn ghost" type="button" data-arm>Delete</button>
          <button class="btn pl-sure" type="submit" hidden>Yes, delete</button>
          <button class="btn ghost" type="button" data-cancel hidden>Keep</button>
        </form>
      </div>
    </div>
  <% }) %>
</div></section>
<script>
// Delete asks once more on the same message before removing it
document.querySelectorAll('.pl-del').forEach(f => {
  const arm = f.querySelector('[data-arm]'), sure = f.querySelector('.pl-sure'), cancel = f.querySelector('[data-cancel]');
  const set = on => { arm.hidden = on; sure.hidden = !on; cancel.hidden = !on; f.previousElementSibling.hidden = on; };
  arm.addEventListener('click', () => { set(true); sure.focus(); });
  cancel.addEventListener('click', () => set(false));
});
</script>
<%- include('../partials/v2/foot') %>
