<%- include('../partials/v2/head') %>
<section class="page gut ad"><div class="in" style="display:grid;gap:20px;max-width:1000px">
  <div class="ad-head" style="margin:0">
    <div><a href="/admin" style="font-size:14px">← Dashboard</a><h1>Blog <span class="muted tabnum" style="font-size:.5em"><%= posts.length %></span></h1></div>
    <div class="buyrow"><a class="btn" href="/admin/blog/new">Write a post</a><a class="btn ghost" href="/blog">See the blog</a></div>
  </div>
  <% if (saved) { %><p class="pf-ok" role="status">Post <%= { added: 'published', updated: 'saved', removed: 'deleted' }[saved] || 'saved' %>.</p><% } %>
  <% if (!posts.length) { %><p class="ad-empty card">No posts yet. Write the first one.</p><% } %>
  <div class="bl-list">
    <% posts.forEach(post => { %>
      <a class="bl-item" href="/admin/blog/edit/<%= post._id %>">
        <span class="bl-ph"><% if (post.coverImageUrl) { %><img src="<%= post.coverImageUrl %>" alt="" loading="lazy"><% } %></span>
        <span><b><%= post.title %></b>
          <span class="muted"><%= post.topic ? post.topic + ' · ' : '' %><%= post.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span></span>
      </a>
    <% }) %>
  </div>
</div></section>
<%- include('../partials/v2/foot') %>
