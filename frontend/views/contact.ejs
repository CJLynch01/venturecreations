<%- include('partials/v2/head', { title: 'Contact' }) %>
<section class="page gut"><div class="narrow" style="display:grid;gap:20px">
  <div><div class="eyebrow">Contact</div><h1 style="font-size:clamp(34px,5vw,54px)">Let's make <em>something</em></h1>
    <p class="muted" style="font-size:18px">A question, a custom idea, a group order with a logo or a list of names? Send it here and we'll get back to you.</p></div>
  <% if (success === 'true') { %><p class="ok">Thank you! Your message was sent. We'll reply by email.</p><% } %>
  <form action="/contact" method="POST" class="form card">
    <div class="field"><label for="name">Name</label><input type="text" id="name" name="name" autocomplete="name" required></div>
    <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" autocomplete="email" required></div>
    <div class="field"><label for="subject">What's it about?</label><input type="text" id="subject" name="subject" placeholder="Group order, custom shirt, an order question…" required></div>
    <div class="field"><label for="message">Message</label><textarea id="message" name="message" rows="6" required></textarea></div>
    <button class="btn" type="submit">Send message</button>
  </form>
</div></section>
<%- include('partials/v2/foot') %>
