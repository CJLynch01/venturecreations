<%- include('../partials/v2/head') %>
<section class="page gut"><div class="narrow" style="display:grid;gap:20px">
  <div><div class="eyebrow">My account</div><h1 style="font-size:clamp(32px,5vw,48px)">Hi, <em><%= user.name ? user.name.split(' ')[0] : 'there' %></em></h1>
    <p class="muted"><%= user.email %> · <a href="/auth/logout">Sign out</a></p></div>
  <div class="card">
    <h2 style="font-size:26px">Your orders</h2>
    <% if (!orders.length) { %>
      <p class="muted">No orders yet. <a href="/shop">Find a shirt</a></p>
    <% } else { orders.forEach(order => { %>
      <div class="order">
        <div class="line" style="display:flex;justify-content:space-between;gap:12px"><b><%= order.createdAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></b><span class="tabnum">$<%= order.total.toFixed(2) %> · <%= order.status %></span></div>
        <% order.items.forEach(item => { %><span class="muted" style="font-size:14px"><%= item.quantity %> × <%= item.name %></span><% }) %>
      </div>
    <% }) } %>
  </div>
</div></section>
<%- include('../partials/v2/foot') %>
