<%- include('partials/v2/head') %>
<% const product = active.product; %>
<div class="gut"><div class="in builder one">
  <form class="ctl" action="/cart/custom" method="POST" id="missionForm" data-cart-form>
    <div>
      <div class="eyebrow">Custom shirts</div>
      <h1><% if (active.mission) { %>Every mission, <em>made to order</em><% } else { %>Your temple, <em>made to order</em><% } %></h1>
    </div>

    <% if (styles.length > 1) { %>
      <div class="field"><span class="lbl">Choose a style</span>
        <div class="styles">
          <% styles.forEach(s => { %>
            <a class="style" href="/custom?style=<%= s.id %>" aria-current="<%= s.id === active.id %>">
              <img src="<%= s.product.images[0] %>" alt="" loading="lazy">
              <span><b><%= s.name %></b><span class="muted">$<%= s.product.price.toFixed(2) %></span></span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
    <p class="lead" style="margin:0"><%= active.blurb %></p>
    <input type="hidden" name="productId" value="<%= product._id %>">

    <div class="field"><label for="mName"><%= active.nameLabel %></label>
      <input type="text" id="mName" name="mission" placeholder="<%= active.namePh %>" maxlength="40" autocomplete="off" required></div>

    <div class="field"><label for="mPlace"><%= active.placeLabel %></label>
      <input type="text" id="mPlace" name="place" placeholder="<%= active.placePh %>" maxlength="40" autocomplete="off" required></div>

    <% if (active.things) { %>
      <div class="field"><span class="lbl">Four things that describe the mission</span>
        <div class="things">
          <% [0, 1, 2, 3].forEach(i => { %>
            <label class="thing"><span><%= i + 1 %></span><input type="text" name="things[<%= i %>]" placeholder="Thing <%= i + 1 %>" maxlength="30" autocomplete="off" aria-label="Thing <%= i + 1 %>"></label>
          <% }) %>
        </div>
        <span class="muted" style="font-size:13px">Anything that says "my mission": a food, an animal, a landmark, the weather.</span>
      </div>
    <% } %>

    <div class="field"><span class="lbl">Shirt color: <span id="colorName"><%= product.colors[0] %></span></span>
      <input type="hidden" name="color" id="colorIn" value="<%= product.colors[0] %>">
      <div class="swatches" data-pick="color"><% product.colors.forEach((c, i) => { %><button type="button" class="sw" style="background:<%= shop.colorHex(c) %>" aria-label="<%= c %>" aria-pressed="<%= i === 0 %>" data-v="<%= c %>"></button><% }) %></div></div>

    <div class="field"><span class="lbl">Size</span>
      <input type="hidden" name="size" id="sizeIn" value="">
      <div class="sizes" data-pick="size"><% product.sizes.forEach(s => { %><button type="button" aria-pressed="false" data-v="<%= s %>"><%= s %></button><% }) %></div></div>

    <div class="msg" id="buyMsg" role="alert"></div>
    <div class="buyrow"><span class="price tabnum">$<%= product.price.toFixed(2) %></span>
      <button class="btn" type="submit">Add to cart</button><a class="btn ghost" href="/groups?style=<%= active.id %>">Order for a group</a></div>
    <p class="muted" style="font-size:14px;margin:0">Every design is drawn by hand. Elisha emails you a proof before anything is printed.</p>
  </form>
</div></div>

<section class="blk gut" style="padding-top:0"><div class="in">
  <div class="head"><div><div class="eyebrow">Examples · <%= active.name %></div><h2><% if (active.mission) { %>From our press <em>to the mission field</em><% } else { %>Temples <em>she's drawn</em><% } %></h2>
    <% if (active.mission) { %><p class="muted" style="margin:6px 0 0;max-width:60ch">Real shirts for real missionaries and the families cheering them on.</p><% } %></div></div>
  <div class="realgrid"><% product.images.forEach((src, i) => { %><button type="button" data-zoom="<%= i %>" aria-label="See example <%= i + 1 %> up close"><img src="<%= src %>" alt="A finished <%= active.name %> shirt" loading="lazy"></button><% }) %></div>
  <p class="muted" style="font-size:14px;margin:12px 0 0">Tap a shirt to see it up close.</p>
</div></section>

<dialog class="zoom" id="zoom" aria-label="Example shirt up close">
  <img alt="">
  <button type="button" class="zoom-x" data-z="close" aria-label="Close">×</button>
  <button type="button" class="zoom-nav zoom-prev" data-z="-1" aria-label="Previous shirt">‹</button>
  <button type="button" class="zoom-nav zoom-next" data-z="1" aria-label="Next shirt">›</button>
  <span class="zoom-n tabnum"></span>
</dialog>
<script>
(() => {
  // Example shirts open full size; arrows, keyboard and swipe move between them
  const box = document.getElementById('zoom'), big = box.querySelector('img'), n = box.querySelector('.zoom-n');
  const imgs = [...document.querySelectorAll('.realgrid img')];
  let at = 0, x0 = null;
  const show = i => { at = (i + imgs.length) % imgs.length; big.src = imgs[at].src; big.alt = imgs[at].alt; n.textContent = (at + 1) + ' of ' + imgs.length; };
  document.querySelectorAll('[data-zoom]').forEach(b => b.addEventListener('click', () => { show(+b.dataset.zoom); box.showModal(); }));
  box.addEventListener('click', e => {
    const z = e.target.closest('[data-z]')?.dataset.z;
    if (z === 'close' || e.target === box) box.close(); else if (z) show(at + +z);
  });
  box.addEventListener('keydown', e => { if (e.key === 'ArrowRight') show(at + 1); if (e.key === 'ArrowLeft') show(at - 1); });
  box.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; }, { passive: true });
  box.addEventListener('touchend', e => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1)); x0 = null; });
})();
</script>
<%- include('partials/v2/trust') %>
<%- include('partials/v2/foot') %>
