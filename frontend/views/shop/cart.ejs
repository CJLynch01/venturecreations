<%- include('../partials/v2/head') %>
<% const c = cartData; const money = n => '$' + n.toFixed(2); %>
<div class="gut"><div class="in">
  <div class="head" style="margin:36px 0 0"><h1>Your cart</h1></div>
  <% if (!c.lines.length) { %>
    <div class="card" style="margin:24px 0 64px;text-align:center;display:grid;gap:14px;justify-items:center">
      <p class="muted" style="margin:0">Your cart is empty.</p>
      <div class="buyrow"><a class="btn" href="/shop">Shop shirts</a><a class="btn ghost" href="/mission">Make a mission shirt</a></div>
    </div>
  <% } else { %>
  <div class="cartpage">
    <div>
      <% c.lines.forEach(l => { %>
        <div class="ci">
          <img src="<%= l.product.images[0] %>" alt="">
          <div><a href="/shop/<%= l.product._id %>" style="color:inherit;text-decoration:none"><b><%= l.product.name %></b></a>
            <small><%= [l.size, l.color].filter(Boolean).join(' · ') %></small>
            <% if (l.custom) { %><small><%= l.custom.mission %><%= l.custom.place ? ' · ' + l.custom.place : '' %></small><% if (l.custom.things.length) { %><small><%= l.custom.things.join(' · ') %></small><% } %><% } %>
            <small class="tabnum"><%= money(l.each) %> each</small>
          </div>
          <div class="r">
            <b class="tabnum"><%= money(l.total) %></b>
            <form action="/cart/update" method="POST" class="qtyctl">
              <input type="hidden" name="lineId" value="<%= l.id %>">
              <button type="submit" name="action" value="decrease" aria-label="One less">−</button><span class="tabnum"><%= l.quantity %></span><button type="submit" name="action" value="increase" aria-label="One more">+</button>
            </form>
            <form action="/cart/remove" method="POST"><input type="hidden" name="lineId" value="<%= l.id %>"><button class="linkbtn" type="submit">Remove</button></form>
          </div>
        </div>
      <% }) %>
      <p style="margin-top:18px"><a href="/shop">← Keep shopping</a></p>
    </div>

    <aside class="summary">
      <div class="line"><span>Subtotal (<%= c.count %> shirt<%= c.count === 1 ? '' : 's' %>)</span><b class="tabnum"><%= money(c.subtotal) %></b></div>
      <% if (c.discount) { %><div class="line save"><span>Group discount (<%= Math.round(c.off * 100) %>%)</span><b class="tabnum">−<%= money(c.discount) %></b></div><% } %>
      <div class="line"><span>Shipping</span><b class="tabnum"><%= c.shipping ? money(c.shipping) : 'Free' %></b></div>
      <div class="line muted"><span>Estimated tax</span><span class="tabnum"><%= money(c.tax) %></span></div>
      <div class="line total"><span>Total</span><span class="tabnum"><%= money(c.total) %></span></div>
      <% if (c.toFreeShipping > 0) { %><div class="hint">You're <b class="tabnum"><%= money(c.toFreeShipping) %></b> away from free shipping.</div><% } %>
      <% if (c.nextTier) { %><div class="hint">Add <b><%= c.nextTier.need %></b> more shirt<%= c.nextTier.need > 1 ? 's' : '' %> for <%= Math.round(c.nextTier.off * 100) %>% off everything.</div><% } %>
      <button class="btn block" type="button" id="checkoutBtn">Check out securely</button>
      <div class="msg" id="checkoutMsg" role="alert"></div>
      <small class="muted">Payment, shipping and the final tax are handled by Stripe. You don't need an account.</small>
    </aside>
  </div>
  <% } %>
</div></div>
<%- include('../partials/v2/foot') %>
