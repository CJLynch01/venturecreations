<%- include('partials/v2/head') %>

<section class="home gut"><div class="in">
  <div>
    <div class="eyebrow"><% if (season && season.effects) { %><%= season.name %> · <% } %>Custom shirts · made to order</div>
    <h1>Shirts for <em>every venture</em></h1>
    <p class="lead">Faith, family, missions, hard days and happy ones. Soft tees with designs that say something, and every one can be made yours.</p>
    <div class="row"><a class="btn" href="/shop">Shop the collection</a><a class="btn ghost" href="/custom">Make one custom</a></div>
  </div>
  <div class="collage">
    <% hero.forEach(p => { %><a href="<%= productPath(p) %>"><img src="<%= p.images[0] %>" alt="<%= p.name %> t-shirt"></a><% }) %>
  </div>
</div></section>

<section class="gut" style="padding-block:34px 10px"><div class="in">
  <div class="tiles">
    <% collections.forEach(c => { %>
      <a class="tile" href="/shop?c=<%= c.id %>"><img src="<%= c.cover.images[0] %>" alt="" loading="lazy"><b><%= c.name %></b></a>
    <% }) %>
  </div>
</div></section>

<%
  const ROW = { valentines: "Valentine's shirts", easter: 'Easter shirts', july4: '4th of July shirts', backtoschool: 'Back to school', halloween: 'Halloween shirts', thanksgiving: 'Fall favorites', christmas: 'Christmas shirts' };
  const rows = [];
  if (season && seasonal.length >= 2) rows.push({ eyebrow: season.name, title: ROW[season.id], list: seasonal, link: season.link });
  if (season && season.upcoming && upcoming.length >= 2) rows.push({ eyebrow: 'Coming up', title: season.upcoming.name + ' is coming', list: upcoming, link: season.upcoming.link });
%>
<% rows.forEach(r => { %>
<section class="blk gut seasonal-row" style="padding-bottom:0"><div class="in">
  <div class="head"><div><div class="eyebrow"><%= r.eyebrow %></div><h2><%= r.title %></h2></div><a class="btn ghost" href="<%= r.link %>">See them all</a></div>
  <div class="grid"><% r.list.slice(0, 4).forEach(p => { %><%- include('partials/v2/card', { p }) %><% }) %></div>
</div></section>
<% }) %>

<%- include('partials/v2/trust') %>

<section class="blk gut"><div class="in">
  <div class="head"><div><div class="eyebrow">New in the shop</div><h2>Shop by what you love</h2></div><a class="btn ghost" href="/shop">See all shirts</a></div>
  <div class="grid">
    <% products.forEach(p => { %><%- include('partials/v2/card', { p }) %><% }) %>
  </div>
</div></section>

<section class="blk gut" style="padding-top:0"><div class="in">
  <div class="make">
    <a class="mk" href="/custom"><% if (mission && mission.images[0]) { %><img src="<%= mission.images[0] %>" alt="" loading="lazy"><% } %>
      <span><span class="eyebrow">Custom mission shirts</span><b>Any mission, any color</b><span class="d">Your state or country in the middle and four things that describe the mission, drawn by hand.</span><span class="go">Design yours →</span></span></a>
    <a class="mk dark" href="/groups"><span class="big tabnum">-<%= Math.round(shop.BULK_TIERS[0].off * 100) %>%</span>
      <span><span class="eyebrow">Group orders</span><b>Youth groups, treks, reunions</b><span class="d">The price drops at <%= [...shop.BULK_TIERS].reverse().map(t => t.min).join(', ') %> shirts. See your total before you order.</span><span class="go">Price your group →</span></span></a>
  </div>
</div></section>

<section class="blk gut" style="padding-top:0"><div class="in">
  <a class="etsy" href="<%= shop.ETSY_URL %>" target="_blank" rel="noopener">
    <span class="etsy-mark" aria-hidden="true">Etsy</span>
    <span><span class="eyebrow">Find us on Etsy too</span><b>Venture Creations on Etsy</b>
      <span class="d">Read our Etsy reviews, favorite the shop, or order there if that's where you like to shop.</span></span>
    <span class="go">Visit our Etsy shop →</span>
  </a>
</div></section>

<%- include('partials/v2/foot') %>
